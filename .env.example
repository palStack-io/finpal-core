# ================================================================
# FinPal - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ================================================================
# Database (required)
# ================================================================
DB_USER=finpal
DB_PASSWORD=change_me_strong_password
DB_NAME=finpal

# ================================================================
# Security (required)
# Generate with: openssl rand -hex 32
# ================================================================
SECRET_KEY=change_me_run_openssl_rand_hex_32
JWT_SECRET_KEY=change_me_run_openssl_rand_hex_32

# ================================================================
# Application
# ================================================================
LOG_LEVEL=INFO
DISABLE_SIGNUPS=False

# Port nginx listens on (default: 80)
HTTP_PORT=80

# ================================================================
# Feature Flags
# ================================================================
INVESTMENT_TRACKING_ENABLED=true
SIMPLEFIN_ENABLED=true

# Financial Modeling Prep API key (optional, for investment data)
FMP_API_KEY=

# ================================================================
# Email - for password reset (optional)
# ================================================================
EMAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ================================================================
# OIDC Single Sign-On (optional)
# ================================================================
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_PROVIDER_NAME=SSO
OIDC_LOGOUT_URI=
APP_URL=http://localhost
LOCAL_LOGIN_DISABLE=False

# ================================================================
# Backups
# ================================================================
# Where on the HOST to store backup files (absolute path recommended)
# Relative paths are relative to the docker-compose.yml directory
BACKUP_PATH=./backups

# Cron schedule — when to run (default: 3 AM daily)
# Examples: "0 3 * * *" = 3 AM daily, "0 */6 * * *" = every 6 hours
BACKUP_SCHEDULE=0 3 * * *

# Days to keep local backup files before purging old ones
BACKUP_RETENTION_DAYS=14

# Optional: ping this URL after every successful backup (healthchecks.io etc.)
BACKUP_HEALTHCHECK_URL=

# ── Remote storage (leave blank to keep backups local only) ──────────────────
# Backblaze B2:       set TYPE=b2,  fill ACCOUNT + KEY
# Cloudflare R2 / S3: set TYPE=s3,  fill PROVIDER + ACCESS_KEY_ID + SECRET + ENDPOINT
BACKUP_REMOTE_BUCKET=
RCLONE_CONFIG_REMOTE_TYPE=
RCLONE_CONFIG_REMOTE_ACCOUNT=
RCLONE_CONFIG_REMOTE_KEY=
RCLONE_CONFIG_REMOTE_PROVIDER=
RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_REMOTE_ENDPOINT=

# ================================================================
# Scheduler
# ================================================================
# Set to false on web workers when running a separate scheduler process.
# With multiple gunicorn workers, leaving this true starts one scheduler per
# worker and every cron job runs that many times.
RUN_SCHEDULER=true

# ================================================================
# Automatic CSV import (folder watch)
# ================================================================
# Root that watched folders must sit inside. A folder outside it is rejected,
# so a compromised admin account cannot point the importer at /etc.
CSV_IMPORT_ROOT=/data/inbox
# Largest CSV accepted, in bytes (default 10 MB). Larger files are quarantined.
CSV_IMPORT_MAX_BYTES=10485760
