# ================================================================
# FinPal - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ================================================================
# Database (required)
# ================================================================
DB_USER=finpal
DB_PASSWORD=change_me_strong_password
DB_NAME=finpal

# ================================================================
# Security (required)
# Generate with: openssl rand -hex 32
# ================================================================
SECRET_KEY=change_me_run_openssl_rand_hex_32
JWT_SECRET_KEY=change_me_run_openssl_rand_hex_32

# ================================================================
# Application
# ================================================================
LOG_LEVEL=INFO
DISABLE_SIGNUPS=False

# Port nginx listens on (default: 80)
HTTP_PORT=80

# ================================================================
# Feature Flags
# ================================================================
INVESTMENT_TRACKING_ENABLED=true
SIMPLEFIN_ENABLED=true

# Financial Modeling Prep API key (optional, for investment data)
FMP_API_KEY=

# pointsPal — credit-card rewards tracking. Part of core and on by default;
# set to false to leave it out entirely (no routes, no tables, no nightly sync).
POINTSPAL_ENABLED=true

# --- Schema reconcile -------------------------------------------------------
# On by default; you do not need to set this.
#
# finPal builds its schema from the models at boot. That creates missing TABLES but
# cannot add a COLUMN to a table that already exists, so an upgraded instance used to
# end up missing every column added since it was installed -- and since the app selects
# every column its models declare, one missing column made the QUERY fail. A missing
# column on `users` meant login itself returned a 500 (issues #122, #124).
#
# Boot now adds missing nullable columns and widens narrowed ones, additively. It never
# drops, renames, narrows or retypes anything, and every statement is logged:
#   docker logs finpal-backend | grep -i "applied:"
#
# Set to false to apply changes yourself, then use the read-only:
#   docker exec finpal-backend python scripts/schema_drift.py
# SCHEMA_AUTO_RECONCILE=true

# Where the card/rewards program catalogue is fetched from, and how often.
# The first boot seeds it once; after that a nightly job refreshes it.
POINTSPAL_SYNC_URL=https://raw.githubusercontent.com/palStack-io/pointsPal/main/dist/programs.json
POINTSPAL_SYNC_INTERVAL_HOURS=24

# ================================================================
# Email - for password reset (optional)
# ================================================================
EMAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ================================================================
# OIDC Single Sign-On (optional)
# ================================================================
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_PROVIDER_NAME=SSO
OIDC_LOGOUT_URI=
APP_URL=http://localhost
LOCAL_LOGIN_DISABLE=False

# ================================================================
# Backups
# ================================================================
# Where on the HOST to store backup files (absolute path recommended)
# Relative paths are relative to the docker-compose.yml directory
BACKUP_PATH=./backups

# Cron schedule — when to run (default: 3 AM daily)
# Examples: "0 3 * * *" = 3 AM daily, "0 */6 * * *" = every 6 hours
BACKUP_SCHEDULE=0 3 * * *

# Days to keep local backup files before purging old ones
BACKUP_RETENTION_DAYS=14

# Optional: ping this URL after every successful backup (healthchecks.io etc.)
BACKUP_HEALTHCHECK_URL=

# ── Remote storage (leave blank to keep backups local only) ──────────────────
# Backblaze B2:       set TYPE=b2,  fill ACCOUNT + KEY
# Cloudflare R2 / S3: set TYPE=s3,  fill PROVIDER + ACCESS_KEY_ID + SECRET + ENDPOINT
BACKUP_REMOTE_BUCKET=
RCLONE_CONFIG_REMOTE_TYPE=
RCLONE_CONFIG_REMOTE_ACCOUNT=
RCLONE_CONFIG_REMOTE_KEY=
RCLONE_CONFIG_REMOTE_PROVIDER=
RCLONE_CONFIG_REMOTE_ACCESS_KEY_ID=
RCLONE_CONFIG_REMOTE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_REMOTE_ENDPOINT=

# ================================================================
# Scheduler
# ================================================================
# Set to false on web workers when running a separate scheduler process.
# With multiple gunicorn workers, leaving this true starts one scheduler per
# worker and every cron job runs that many times.
RUN_SCHEDULER=true

# ================================================================
# Automatic CSV import (folder watch)
# ================================================================
# Root that watched folders must sit inside. A folder outside it is rejected,
# so a compromised admin account cannot point the importer at /etc.
CSV_IMPORT_ROOT=/data/inbox
# Largest CSV accepted, in bytes (default 10 MB). Larger files are quarantined.
CSV_IMPORT_MAX_BYTES=10485760

# ================================================================
# Rate limiting
# ================================================================
# Where login/register rate-limit counters are stored. The default, process
# memory, is per-worker: with gunicorn --workers=3 a "10 per minute" limit is
# really ~30/minute. Point this at a shared store to enforce it exactly.
# Requires the `redis` package when using a redis:// URI.
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# ================================================================
# Agent / API access
# ================================================================
# Personal access tokens are minted per user from Settings > Integrations and
# stored hashed; there is no server-wide switch. What you can configure is where
# their rate-limit counters live — see RATELIMIT_STORAGE_URI above.

# ================================================================
# Native sign-in (mobile apps)
# ================================================================
# Additive to the OIDC redirect flow above — that is what self-hosters on
# Authentik/Keycloak/Authelia use and it is unaffected by these.
# Google OAuth client ID. Setting it enables POST /api/v1/auth/oidc for Google
# and makes a Google button appear in the mobile app.
# GOOGLE_CLIENT_ID=
# Apple: both are required. APPLE_CLIENT_ID is the app's bundle ID, which is the
# audience Apple mints its tokens for.
# APPLE_SIGNIN_ENABLED=false
# APPLE_CLIENT_ID=
